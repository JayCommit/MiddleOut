# MiddleOut S3 Object Storage Configuration

# Bind address and port
HOST=0.0.0.0
PORT=8080

# Local directory where SQLite metadata and object blobs are stored
DATA_DIR=./data

# S3 API credentials (also used as default Web Console login credentials)
# Fallback variables AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are also supported.
MIDDLEOUT_ACCESS_KEY_ID=middleout
MIDDLEOUT_SECRET_ACCESS_KEY=middleout-secret-key

# Optional overrides for the Web Console admin username and password
# (Defaults to MIDDLEOUT_ACCESS_KEY_ID and MIDDLEOUT_SECRET_ACCESS_KEY when unset)
# MIDDLEOUT_ADMIN_USER=admin
# MIDDLEOUT_ADMIN_PASSWORD=change-me

# Default S3 region (fallback AWS_DEFAULT_REGION is also supported)
MIDDLEOUT_REGION=us-east-1

# Maximum allowed size in bytes per object upload or part (default: 1 GiB)
MAX_OBJECT_BYTES=1073741824
