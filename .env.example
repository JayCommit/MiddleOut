# Public origin, including scheme and port. Set your actual URL before signing in.
BETTER_AUTH_URL=http://localhost:8080
# Optional additional registration; the initial administrator is created automatically.
ALLOW_SIGN_UP=false
# Embedded Postgres and the generated signing secret persist here.
DATA_DIR=./data
# Optional external Postgres. Requires a stable secret of at least 32 characters.
# DATABASE_URL=postgresql://user:password@localhost:5432/middleout
# BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Compose raw HTTP stays local by default. Use the HTTPS overlay for public access.
BIND_ADDRESS=127.0.0.1
# HTTPS overlay only; also set BETTER_AUTH_URL=https://this-name.
# MIDDLEOUT_DOMAIN=storage.example.com
MAX_OBJECT_BYTES=8388608
ACCOUNT_QUOTA_BYTES=67108864
# Maintenance checks hourly; uploads expire after 24 hours of inactivity.
MAINTENANCE_INTERVAL_SECONDS=3600
AUDIT_RETENTION_DAYS=90
# Optional metrics bearer token (at least 32 characters); unset disables metrics.
# METRICS_TOKEN=generate-a-random-token
# Set TRUST_PROXY=true when Middle Out is deployed exclusively behind a trusted reverse proxy.
TRUST_PROXY=false
